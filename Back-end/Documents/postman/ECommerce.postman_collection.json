    "_postman_id": "3d8b9e1c-4d4f-4f2d-9c2a-1f3a9b2d0e11",
    "name": "ECommerce API",
    "description": "Coleccion de Postman para la API del sistema ECommerce. Usa {{baseUrl}} con valor por defecto http://127.0.0.1:8000/api. Los endpoints protegidos usan Bearer token en {{accessToken}}.\n\nNota: los endpoints de ordenes y order-items reflejan los serializers actuales del backend; si la creacion falla, el backend necesita completar campos server-side.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "roleId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
